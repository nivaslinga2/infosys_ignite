# ==============================================================================
# AgentShield Production Environment Variables
# ==============================================================================

# Server Configuration
PORT=8000
ENVIRONMENT=production

# Qualcomm Cloud AI 100 / Snapdragon Inference API (Optional)
# If left blank, AgentShield automatically uses local deterministic rule-based inference.
INFERENCE_CLOUD_API_KEY=
QUALCOMM_API_KEY=
INFERENCE_CLOUD_ENDPOINT=https://aisuite.cirrascale.com/apis/v2
QUALCOMM_MODEL=Llama-3.1-8B

# Open Policy Agent (OPA) Integration (Optional)
# If left blank or unreachable, AgentShield uses its built-in authoritative AuthorizationEngine.
OPA_URL=http://localhost:8181

# Frontend API Target (Only needed if frontend is hosted on a different domain)
# VITE_API_BASE=https://api.yourdomain.com
